COMPOSE_PROJECT_NAME=spree-bbs

# Stable Synchronet image used by default. Override to a newer nightly only when
# you are ready to test config migrations.
SYNCHRONET_IMAGE=bbsio/synchronet:3.19c
SYNCHRONET_BASE_IMAGE=bbsio/synchronet:3.19c
SYNCHRONET_DOS_IMAGE=spree/synchronet-dosemu:local

# Bind local services to loopback so the sandbox is private by default.
BBS_HOST=127.0.0.1
TELNET_PORT=2323
HTTP_PORT=8080
HTTPS_PORT=8443
RLOGIN_PORT=2513
WS_TERM_PORT=1123
WSS_TERM_PORT=11235
NNTP_PORT=1119
IRC_PORT=6667

