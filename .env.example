COMPOSE_PROJECT_NAME=spree-bbs

# Stable upstream image used by the non-DOS compose path.
SYNCHRONET_IMAGE=bbsio/synchronet:3.19c

# The DOS image is built locally from Ubuntu 24.04, a pinned Synchronet source
# commit, and the native Noble build from the official DOSEMU2 PPA.
SYNCHRONET_DOS_IMAGE=spree/synchronet-dosemu:local
SYNCHRONET_COMMIT=74911bb1379078e52a52f4cac47696ca4190d3f9
DOSEMU2_VERSION=2.0~pre9-10228-0aeb4d174+202607270023~ubuntu24.04.1

# Bind local services to loopback so the sandbox is private by default.
BBS_HOST=127.0.0.1
TELNET_PORT=2323
HTTP_PORT=8080
HTTPS_PORT=8443
RLOGIN_PORT=2513
WS_TERM_PORT=1123
WSS_TERM_PORT=11235
NNTP_PORT=1119
IRC_PORT=6667
